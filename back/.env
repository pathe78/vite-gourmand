# Valeurs PAR DÉFAUT, sans aucun secret (ce fichier est versionné).
# Les vraies valeurs se mettent :
#   - en local    : dans .env.local (non versionné, voir .env.local.example)
#   - en production : dans les variables d'environnement de l'hébergeur (Railway)

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changez_moi_en_local
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:@127.0.0.1:3306/vite_gourmand?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
CONTACT_EMAIL=contact@vitegourmand.fr
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changez_moi_en_local
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Front local (Live Server, serve...) sur localhost ou 127.0.0.1, n'importe quel port
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> MongoDB (statistiques) ###
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=vite_gourmand_stats
###< MongoDB ###
