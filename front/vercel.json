{
    
    "rewrites": [
        {
            "source": "/((?!js|scss|images|router|pages).*)",
            "destination": "/index.html"
        }
    ],

    "headers": [
        {
            "source": "/js/(.*)",
            "headers": [
                { "key": "Content-Type", "value": "application/javascript" }
            ]
        }
    ]
}